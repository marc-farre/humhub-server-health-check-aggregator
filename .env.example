# =============================================================================
# health-aggregator.php configuration
# -----------------------------------------------------------------------------
# Copy to `.env` next to health-aggregator.php, then:
#     chmod 600 .env
# Defaults are shown in [brackets]. A real environment variable of the same name
# overrides the value here.
# =============================================================================

# --- Access to THIS endpoint --------------------------------------------------
# REQUIRED. Without it every HTTP request is refused (fail closed), because this
# endpoint reveals the health of every instance at once.
# Generate with:  openssl rand -hex 32
AGGREGATOR_TOKEN=

# Optional: only these IPs may call the aggregator (your Uptime Kuma host). []
ALLOW_IPS=

# Treat instances that only have warnings as a failure (HTTP 503). [false]
FAIL_ON_WARNING=false

# --- Instances to check -------------------------------------------------------
# Number them from 1 upwards, without gaps. Each needs a URL; LABEL and TOKEN
# are optional (LABEL defaults to the host name, TOKEN to DEFAULT_TOKEN).
#
# The token is sent as an `X-Health-Token` header so it stays out of the target's
# access log. If you prefer it in the URL, just append ?token=... to TARGET_n_URL
# and it will be used as given.

TARGET_1_LABEL=instance-one
TARGET_1_URL=https://one.example.org/humhub-server-health-check/health-check.php
TARGET_1_TOKEN=

TARGET_2_LABEL=instance-two
TARGET_2_URL=https://two.example.org/humhub-server-health-check/health-check.php
TARGET_2_TOKEN=

# Fallback token for every target that does not define its own. Handy when all
# instances are deployed with the same HEALTH_TOKEN. []
DEFAULT_TOKEN=

# Skip TLS verification (self-signed staging certificates only). [false]
DEFAULT_INSECURE=false
# Per target: TARGET_1_INSECURE=true
# Per target, override the Host header (checking an instance by IP):
#   TARGET_1_HOST_HEADER=one.example.org

# Highest TARGET_n_ number scanned. [100]
MAX_TARGETS=100

# --- Timeouts -----------------------------------------------------------------
# All instances are fetched in parallel, so the total runtime is roughly the
# slowest instance, not the sum. Keep TIMEOUT below the Uptime Kuma timeout.
TIMEOUT=15
CONNECT_TIMEOUT=5
MAX_RESPONSE_KB=256

# --- Output -------------------------------------------------------------------
# Include the warning lines of failing instances (and of all instances in
# verbose mode). [true]
SHOW_WARNINGS=true

# Cap the detail lines printed per instance, so one very broken server cannot
# bury the others in the alert. [10]
MAX_DETAIL_LINES=10
