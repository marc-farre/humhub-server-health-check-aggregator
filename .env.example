# =============================================================================
# health-aggregator.php configuration
# -----------------------------------------------------------------------------
# Copy to `.env` next to health-aggregator.php, then:
#     chmod 600 .env
# Defaults are shown in [brackets]. A real environment variable of the same name
# overrides the value here.
# =============================================================================

# --- Access to THIS endpoint --------------------------------------------------
# REQUIRED. Without it every HTTP request is refused (fail closed), because this
# endpoint reveals the health of every instance at once.
# Generate with:  openssl rand -hex 32
AGGREGATOR_TOKEN=

# Optional: only these IPs may call the aggregator (your Uptime Kuma host). []
ALLOW_IPS=

# Treat instances that only have warnings as a failure (HTTP 503). [false]
FAIL_ON_WARNING=false

# --- Instances to check -------------------------------------------------------
# One `TARGET_URL[]` line per instance, in any order, as many as you like. A URL
# is all each one needs: the instance is named after the host in it, so the two
# below appear in the output, the log and the alerts as `one.example.org` and
# `two.example.org`.
#
# Anything else that instance needs goes after the URL, separated by `|`:
#   token        this instance's own token, if it differs from TARGET_TOKEN
#                — or put it in the URL as ?token=..., as described below
#   label        override the derived name — for instance when several
#                instances share a host and the host name alone would not tell
#                them apart:  |label=intranet (staging)
#   insecure     skip TLS verification (self-signed staging certificates only)
#   host_header  override the Host header (checking an instance by IP)
#   timeout      override TIMEOUT for one habitually slow instance instead of
#                raising it for the whole fleet. 0 means none, as in cURL
# A setting with no value is on, so `|insecure` means `|insecure=true`.
#
# The token is sent as an `X-Health-Token` header so it stays out of the target's
# access log. A ?token=... in the URL is used as given instead — as on the second
# line below, which is then a URL that also works pasted into a browser. Left
# empty, it falls back to TARGET_TOKEN like any other instance.

TARGET_URL[]=https://one.example.org/humhub-server-health-check/health-check.php
TARGET_URL[]=https://two.example.org/humhub-server-health-check/health-check.php?token=

# Fallback token for every instance that does not carry its own. Handy when all
# instances are deployed with the same HEALTH_TOKEN. []
TARGET_TOKEN=

# Skip TLS verification for every instance. [false]
TARGET_INSECURE=false

# Where a `.env` is not an option — a container configured through the
# environment, which cannot give the same variable twice — pass the whole list as
# one comma-separated TARGET_URL instead. The `|` settings work there too:
#   TARGET_URL=https://one.example.org/health-check.php,https://two.example.org/health-check.php|token=...

# --- Timeouts -----------------------------------------------------------------
# All instances are fetched in parallel, so the total runtime is roughly the
# slowest instance, not the sum. Keep TIMEOUT below the Uptime Kuma timeout.
TIMEOUT=15
CONNECT_TIMEOUT=5
MAX_RESPONSE_KB=256

# --- Output -------------------------------------------------------------------
# Include the warning lines of failing instances (and of all instances in
# verbose mode). [true]
SHOW_WARNINGS=true

# Print the remote's advice line ("-> do this") under each error and warning.
# [true]
SHOW_HINTS=true

# Cap the detail lines printed per instance, so one very broken server cannot
# bury the others in the alert. [10]
MAX_DETAIL_LINES=10

# --- Retries and slow instances -----------------------------------------------
# (extends the Timeouts section above)

# Transport failures — a timeout, a refused connection, a TLS error — are retried
# this many times before an instance is called DOWN, so one dropped connection
# does not page you. Only failures to *answer* are retried: an instance that
# reported errors reported them, and asking again would not change that.
# Worst case a run takes TIMEOUT x (RETRIES + 1), so keep the Uptime Kuma
# request timeout above that. 0 disables retrying. [1]
#RETRIES=1

# Instances slower than this are marked ", slow" in the output and in the log.
# This is the early warning: the run before an instance crosses TIMEOUT and
# starts being reported as down. 0 disables the marker. [5000]
#SLOW_MS=5000

# TIMEOUT can be overridden for one habitually slow instance instead of being
# raised for the whole fleet — see `timeout` in "Instances to check" above.

# --- Log ----------------------------------------------------------------------
# Run from a monitor, the response body is the only thing anyone ever sees, and
# only for as long as Uptime Kuma keeps it. Failures, state changes and any PHP
# error the aggregator hits are therefore appended to a log file, which is
# readable over HTTP with the same token:
#
#   curl "https://monitor.example.org/health-aggregator/health-aggregator.php?token=...&log=100"
#   php health-aggregator.php --log=100 | --log-path | --clear-log

# Master switch. [true]
#LOG_ENABLED=true

# Where to write. [health-aggregator.log next to this script]
# The bundled .htaccess already denies .log; on nginx add it to your deny rule.
# If the path is not writable by the PHP user, a private directory under the
# system temp directory is used instead and the response body says so — a log
# that fails silently is worse than no log.
#LOG_FILE=

# What gets written. A monitor polls constantly, so the default records events
# rather than runs:
#   all       every run
#   changes   every run that is not healthy, the run that recovers, and a
#             reminder every LOG_REPEAT_MINUTES while a problem persists
#   problems  as changes, but without the line saying everything is fine again
#   off       nothing
# [changes]
#LOG_EVENTS=changes

# text (default) or json — json writes one JSON object per line. [text]
#LOG_FORMAT=text

# Include each instance's individual error and warning lines, not just the
# per-instance summary. [true]
#LOG_DETAIL=true

# How often an unchanged problem is repeated, so a long outage does not bury the
# incident under one line per poll. 0 = every run. [60]
#LOG_REPEAT_MINUTES=60

# Rotation: <file> -> <file>.1 once the log passes LOG_MAX_KB.
# LOG_MAX_KB=0 disables rotation, LOG_KEEP=0 truncates instead of rotating.
#LOG_MAX_KB=1024
#LOG_KEEP=1

# Allow reading the log over HTTP with ?log=N. The CLI options work either way.
# [true]
#LOG_VIEW=true

# Remembers what the previous run saw, for change detection and the "since"
# timestamp on failing instances.
# [.health-aggregator-state.json next to this script]
#STATE_FILE=
